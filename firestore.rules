rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------------------------------------------------------------- Hàm dùng chung
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function isTeacher() {
      return signedIn() && exists(/databases/$(db)/documents/teachers/$(me()));
    }
    function teacher() { return get(/databases/$(db)/documents/teachers/$(me())).data; }

    // Vai trò (cột E trong tab GiaoVien): tt1/tt2/tt3 => leadTo = 1/2/3 (tổ trưởng); x => admin (toàn khoa)
    function isAdmin() { return isTeacher() && teacher().get('admin', false) == true; }
    function leadTo() { return teacher().get('leadTo', 0); }
    function isManager() { return isAdmin() || leadTo() > 0; }
    function canEditTo(n) { return isAdmin() || leadTo() == n; }   // được sửa số GV cần của tổ n

    function dotData(dotId) { return get(/databases/$(db)/documents/dots/$(dotId)).data; }
    // GV đăng ký được: trạng thái MO và chưa quá hạn chót
    function dotOpen(dotId) {
      let d = dotData(dotId);
      return d.get('status', 'DONG') == 'MO' && request.time < d.deadline;
    }
    // Tổ trưởng thêm/sửa ca được: trạng thái SOAN (soạn lịch) hoặc MO
    function dotEditable(dotId) { return dotData(dotId).get('status', 'DONG') in ['SOAN', 'MO']; }
    function slotOf(slotId) { return get(/databases/$(db)/documents/slots/$(slotId)).data; }

    // Số GV cần: đủ 3 khoá t1,t2,t3, là số nguyên 0..20
    function needShapeOk(n) {
      return n.keys().hasOnly(['t1', 't2', 't3']) && n.keys().hasAll(['t1', 't2', 't3'])
        && n.t1 is int && n.t2 is int && n.t3 is int
        && n.t1 >= 0 && n.t1 <= 20 && n.t2 >= 0 && n.t2 <= 20 && n.t3 >= 0 && n.t3 <= 20;
    }
    // Tạo ca mới: chỉ được điền số cho tổ mình phụ trách, tổ khác phải bằng 0
    function needCreateOk(n) {
      return needShapeOk(n) && (canEditTo(1) || n.t1 == 0) && (canEditTo(2) || n.t2 == 0) && (canEditTo(3) || n.t3 == 0);
    }
    // Sửa ca đã có: chỉ được đổi số của tổ mình, số của tổ khác phải giữ nguyên
    function needUpdateOk(n, o) {
      return needShapeOk(n) && (canEditTo(1) || n.t1 == o.t1) && (canEditTo(2) || n.t2 == o.t2) && (canEditTo(3) || n.t3 == o.t3);
    }

    // ---------------------------------------------------------------- Người dùng
    match /teachers/{e} {
      // Đọc: chính mình; admin đọc tất cả; tổ trưởng đọc GV cùng tổ mình phụ trách
      allow read: if signedIn() && (e == me() || (isTeacher() && (isAdmin() || (leadTo() > 0 && resource.data.to == leadTo()))));
      // GV chỉ được tự tắt cờ "đang dùng mật khẩu tạm" của chính mình (sau khi đổi mật khẩu)
      allow update: if signedIn() && e == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwTemp'])
        && request.resource.data.pwTemp == false;
      allow create, delete: if false;     // do Apps Script ghi
    }

    // Tên + tổ của mọi GV để vẽ bảng; KHÔNG có số ca đã gác (nằm ở teachers)
    match /roster/{e} { allow read: if isTeacher(); allow write: if false; }
    match /config/{d} { allow read: if isTeacher(); allow write: if false; }
    match /dots/{d}   { allow read: if isTeacher(); allow write: if false; }

    // ---------------------------------------------------------------- Ca thi (tổ trưởng thêm / sửa trên web)
    // Mã ca = <đợt>-<yyyymmdd>-c<ca>-k<khoá>-<ngành>: cố định theo nội dung, nên không tạo được 2 ca trùng.
    // Mỗi tổ chỉ được sửa số GV cần của tổ mình; "xoá ca" = đặt số của tổ mình về 0.
    match /slots/{s} {
      allow read: if isTeacher();
      allow create: if isTeacher() && isManager()
        && request.resource.data.dotId is string
        && dotEditable(request.resource.data.dotId)
        && request.resource.data.namHoc == dotData(request.resource.data.dotId).namHoc
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.ca in [1, 2, 3, 4]
        && request.resource.data.nganh in ['SPA', 'NNA']
        && request.resource.data.khoa is int
        && s == request.resource.data.dotId + '-' + request.resource.data.date.replace('-', '') + '-c' + string(request.resource.data.ca) + '-k' + string(request.resource.data.khoa) + '-' + request.resource.data.nganh
        && needCreateOk(request.resource.data.need);
      allow update: if isTeacher() && isManager()
        && dotEditable(resource.data.dotId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['need', 'mon', 'note'])
        && needUpdateOk(request.resource.data.need, resource.data.need);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- Đăng ký (chống vượt số lượng không cần bộ đếm)
    // Mỗi "chỗ" của một tổ trong một ca là một tài liệu claims/<slotId>_t<tổ>_<k>, 1 <= k <= số GV cần.
    // Mã tài liệu là duy nhất => người thứ hai tranh cùng chỗ sẽ bị từ chối.
    // Đăng ký = ghi đồng thời regs + claims trong một batch; mỗi bên kiểm tra bên kia.
    match /claims/{c} {
      allow read: if false;
      allow create: if isTeacher()
        && request.resource.data.email == me()
        && request.resource.data.to == teacher().to
        && dotOpen(request.resource.data.dotId)
        && slotOf(request.resource.data.slotId).dotId == request.resource.data.dotId
        && request.resource.data.k is int
        && request.resource.data.k >= 1
        && request.resource.data.k <= slotOf(request.resource.data.slotId).need.get('t' + string(request.resource.data.to), 0)
        && c == request.resource.data.slotId + '_t' + string(request.resource.data.to) + '_' + string(request.resource.data.k)
        && existsAfter(/databases/$(db)/documents/regs/$(request.resource.data.regId))
        && getAfter(/databases/$(db)/documents/regs/$(request.resource.data.regId)).data.claimId == c;
      allow update: if false;
      allow delete: if isTeacher()
        && resource.data.email == me()
        && dotOpen(resource.data.dotId)
        && !existsAfter(/databases/$(db)/documents/regs/$(resource.data.regId));
    }

    // Mã đăng ký = <ngày>_<ca>__<email> => mỗi GV chỉ có 1 ca tại một (ngày, ca), dù thuộc đợt nào
    match /regs/{r} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.email == me()
        && request.resource.data.to == teacher().to
        && request.resource.data.name == teacher().name
        && dotOpen(request.resource.data.dotId)
        && slotOf(request.resource.data.slotId).dotId == request.resource.data.dotId
        && slotOf(request.resource.data.slotId).date == request.resource.data.date
        && slotOf(request.resource.data.slotId).ca == request.resource.data.ca
        && slotOf(request.resource.data.slotId).namHoc == request.resource.data.namHoc
        && r == request.resource.data.date + '_' + string(request.resource.data.ca) + '__' + me()
        && existsAfter(/databases/$(db)/documents/claims/$(request.resource.data.claimId))
        && getAfter(/databases/$(db)/documents/claims/$(request.resource.data.claimId)).data.slotId == request.resource.data.slotId;
      allow update: if false;
      allow delete: if isTeacher()
        && resource.data.email == me()
        && dotOpen(resource.data.dotId)
        && !existsAfter(/databases/$(db)/documents/claims/$(resource.data.claimId));
    }
  }
}
